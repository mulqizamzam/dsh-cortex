node_modules/
# Build output at the ROOT only. The unanchored `lib/` also matched
# `src/lib/`, so all eight shared source modules (caps, errors, fsx, gitx,
# home, ids, pid, sanitize) were untracked while src/host imports them —
# HEAD could not build from a fresh clone. Anchor it; `src/lib/` is source.
/lib/
.pnpm-store/
.pnpm-cache/
*.tsbuildinfo

# Build/verification artifacts, not source. The snapshots are .tgz tarballs of
# dist output and the rollback dir holds copies of a previous bundle; both are
# reproducible and would add ~5 MB of binary to every clone. The planning docs
# beside them (.dev/BRIEFS.md, .dev/DISPATCH*.md) ARE tracked.
.dev/snapshots/
.dev/rollback/
